# =========================================================
# URage Now Environment Configuration (Example)
# =========================================================
#
# Copy this file to .env.public.local at the repository root and fill in real values.
# Machine-specific secrets MUST NEVER be committed to version control.
#
# Required:
#   - DISCORD_TOKEN_RUNTIME    (Discord bot token, never share)
#   - DISCORD_CLIENT_ID        (Application client ID)
#   - DISCORD_GUILD_ID         (Target server/guild ID)
#
# Optional overrides per-user:
#   - .env.main.<profile>.local
#   - workers/remote-worker/env/.env.worker.<profile>.local
# =========================================================

# --- Discord ---
# Bot token (OAuth2 token starting with 'Bot ...') - REQUIRED at runtime
DISCORD_TOKEN_RUNTIME=
# Application ID issued by Discord Developer Portal
DISCORD_CLIENT_ID=replace-me
# Target guild/server ID (numeric snowflake)
DISCORD_GUILD_ID=replace-me
HUMBLE_ROLE_ID=replace-me

# --- LLM Providers ---
# Ollama endpoint (accepts both http://host:11434 and http://host:11434/api/generate)
OLLAMA_URL=http://localhost:11434/api/generate
# Default text generation model
OLLAMA_MODEL=qwen3-coder:30b
# Vision-capable model for image analysis
OLLAMA_VISION_MODEL=llava:13b
# Which LLM provider to use: "ollama", "lmstudio", or "llamacpp"
LLM_PROVIDER=ollama

# Preferred generic OpenAI-compatible endpoint. Works with LM Studio and llama.cpp.
# Accepts both http://host:port and http://host:port/v1.
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
# Prefer storing a non-default API key in the native credential store with
# scripts\llm\store-openai-compatible-api-key.cmd. An environment value still
# overrides the native credential for services and CI.
OPENAI_COMPATIBLE_API_KEY=lm-studio
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_VISION_MODEL=
# Legacy aliases remain supported during migration. Do not set both sets unless the
# preferred OPENAI_COMPATIBLE_* values intentionally override the legacy values.
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_API_KEY=lm-studio
# LMSTUDIO_MODEL=
# LMSTUDIO_VISION_MODEL=

# --- Execution Mode ---
# Where to run 3D model generation: "local" or "remote"
MODEL3D_EXECUTION_MODE=local
# Where to run image generation: "local" or "remote"
IMAGE_EXECUTION_MODE=local

# --- Remote Worker ---
# Base URL of the remote generation worker (empty = disabled)
REMOTE_WORKER_BASE_URL=
# Shared secret for authenticating with the remote worker
REMOTE_WORKER_SHARED_SECRET=
REMOTE_WORKER_PORT=5581
REMOTE_WORKER_BIND_HOST=0.0.0.0

# --- Dashboard ---
DASHBOARD_ENABLED=true
DASHBOARD_PORT=4782
DASHBOARD_BIND_HOST=127.0.0.1
# Public URL used by bots running on another machine. Keep loopback for one-machine setups.
DASHBOARD_PUBLIC_BASE_URL=http://127.0.0.1:4782
# Optional additional Android companion leaf-certificate pin for HTTPS discovery.
COMPANION_TLS_CERTIFICATE_SHA256=
# Set both values before exposing the dashboard on a LAN. Use a long random value.
DASHBOARD_EXPOSE_API=false
DASHBOARD_ACCESS_TOKEN=
# Optional LAN allowlist. Comma-separate exact IPs, IPv6 addresses, or IPv4 CIDR ranges.
# Empty permits every LAN client that has DASHBOARD_ACCESS_TOKEN. Example:
# DASHBOARD_ALLOWED_CLIENTS=192.168.1.21,192.168.1.0/24
DASHBOARD_ALLOWED_CLIENTS=
# Protect Telegram, Matrix, and WhatsApp admin APIs when their host is not loopback.
MESSENGER_ADMIN_SHARED_SECRET=

# --- Game Engine Projects (Dashboard) ---
# Override pre-configured Unity projects with a JSON array string.
# Format: 'CONFIGURED_UNITY_PROJECTS=[{"id":"...","title":"...","engine":"unity","executablePath":"...","projectPath":"...","version":"..."}]'
# Leave empty to use the built-in defaults defined in gameEngineProjectManager.ts.
CONFIGURED_UNITY_PROJECTS=
# Optional explicit path to Unity Hub's catalog when the dashboard is not running as the same Windows user as Unity Hub.
# Example: C:\Users\<your-user>\AppData\Roaming\UnityHub\projects-v1.json
UNITY_HUB_PROJECTS_PATH=

# --- Rate Limiting / Spam Protection ---
DUPLICATE_WINDOW_MS=60000
SPAM_TIMEOUT_MS=3600000

# --- ComfyUI ---
# Input directory for ComfyUI (relative or absolute path)
COMFYUI_INPUT_DIR=data/comfyui/input

# Workflow JSON file paths (relative to project root)
COMFYUI_3D_WORKFLOW_PATH=comfyui-workflows/3d/3dmodel_redone.json
COMFYUI_IMAGE_WORKFLOW_PATH=comfyui-workflows/image/image_qwen_image.json
COMFYUI_IMAGE_EDIT_WORKFLOW_PATH=comfyui-workflows/image/image_edit.json
COMFYUI_AUDIO_WORKFLOW_PATH=comfyui-workflows/audio/audio.json
COMFYUI_MUSIC_WORKFLOW_PATH=comfyui-workflows/music/music.json
COMFYUI_VIDEO_WORKFLOW_PATH=comfyui-workflows/video/video.json

# ComfyUI API endpoints
# Main ComfyUI server (for 3D, image workflows)
COMFYUI_MODEL_BASE_URL=http://127.0.0.1:8188
COMFYUI_IMAGE_BASE_URL=http://127.0.0.1:8188
# Separate endpoints for audio/music/video if running on different instances
COMFYUI_AUDIO_BASE_URL=http://127.0.0.1:8188
COMFYUI_MUSIC_BASE_URL=http://127.0.0.1:8188
COMFYUI_VIDEO_BASE_URL=http://127.0.0.1:8188

# Music sampler node mapping. Change node IDs/input keys when using a custom workflow.
COMFYUI_MUSIC_SEED_NODE_ID=52
COMFYUI_MUSIC_SEED_INPUT_KEY=seed
COMFYUI_MUSIC_STEPS_NODE_ID=52
COMFYUI_MUSIC_STEPS_INPUT_KEY=steps
COMFYUI_MUSIC_CFG_NODE_ID=52
COMFYUI_MUSIC_CFG_INPUT_KEY=cfg

# --- Blender ---
# Path to the Blender executable - update if using a different version/location
BLENDER_EXECUTABLE_PATH=C:\\Program Files\\Blender Foundation\\Blender 4.5\\blender.exe

# --- 3D Print Applications ---
# Optional Bambu Studio override. Leave empty to detect common platform install paths.
# Windows example: C:\Program Files\Bambu Studio\bambu-studio.exe
# macOS example: /Applications/BambuStudio.app
# Linux examples: /opt/Bambu_Studio.AppImage or /usr/bin/flatpak
BAMBU_STUDIO_EXECUTABLE_PATH=

# Script paths (relative or absolute) - update if project location changes
BLENDER_OPEN_SCRIPT_PATH=blender-scripts/import.py
BLENDER_LOWPOLY_SCRIPT_PATH=blender-scripts/LowPolyUV.py
BLENDER_MODEL_PREVIEW_SCRIPT_PATH=blender-scripts/RenderModelPreview.py

# Timeout in milliseconds for Blender operations
BLENDER_MODEL_PREVIEW_TIMEOUT_MS=180000
BLENDER_LOWPOLY_TIMEOUT_MS=1200000

# Low-poly generation options
BLENDER_LOWPOLY_MERGE_VERTICES=true
BLENDER_LOWPOLY_SHOULD_DECIMATE=true
BLENDER_LOWPOLY_MAX_COLORS=16
BLENDER_LOWPOLY_BLOCK_SIZE=8
LOWPOLY_DEFAULT_TARGET_FACE_COUNT=1500

# =========================================================
# LAN LLM Notes
# =========================================================
# - OLLAMA_URL accepts both:
#   - http://<host>:11434
#   - http://<host>:11434/api/generate
# - OPENAI_COMPATIBLE_BASE_URL accepts both:
#   - http://<host>:1234
#   - http://<host>:1234/v1
# This lets you run Ollama, LM Studio, or llama.cpp on another machine without installing the bot there.

# Main bot local overrides (not committed).
# Copy this file to .env.main.local at the repository root.
# Optional: keep your runtime token here instead of secure store.
# DISCORD_TOKEN_RUNTIME=your-discord-token

# Optional profile-specific overrides can go into:
# .env.main.devbox.local

# Example: force provider/model for this machine.
# LLM_PROVIDER=lmstudio
# OPENAI_COMPATIBLE_MODEL=qwen/qwen3-8b

# Example: LLM on a LAN machine, image/3D generation local on this machine.
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://192.168.1.50:11434
# MODEL3D_EXECUTION_MODE=local
# IMAGE_EXECUTION_MODE=local
# REMOTE_WORKER_BASE_URL=

# Example: LM Studio on a LAN machine instead.
# LLM_PROVIDER=lmstudio
# OPENAI_COMPATIBLE_BASE_URL=http://192.168.1.60:1234

# Example: llama.cpp on a LAN machine.
# LLM_PROVIDER=llamacpp
# OPENAI_COMPATIBLE_BASE_URL=http://192.168.1.60:8080/v1
# OPENAI_COMPATIBLE_MODEL=your-loaded-model-id

# Optional: disable or force dashboard in a specific launcher/profile.
# DASHBOARD_ENABLED=true

# LAN dashboard example. Use one long random DASHBOARD_ACCESS_TOKEN on every machine
# that needs to call the dashboard, then open the browser URL with ?accessToken=<token> once.
# DASHBOARD_BIND_HOST=0.0.0.0
# DASHBOARD_PUBLIC_BASE_URL=http://192.168.1.20:4782
# DASHBOARD_EXPOSE_API=true
# DASHBOARD_ACCESS_TOKEN=replace-with-a-long-random-secret
# DASHBOARD_ALLOWED_CLIENTS=192.168.1.21,192.168.1.0/24
# MESSENGER_ADMIN_SHARED_SECRET=replace-with-a-different-long-random-secret

# Optional: override the Blender script used by Open In Blender for models and image planes.
# BLENDER_OPEN_SCRIPT_PATH=C:\\Files\\URageStudio\\blender-scripts\\import.py

# Optional: Messenger runtime control from dashboard.
# DISCORD_RUNTIME_AUTOSTART=true
# TELEGRAM_BOT_ENTRY_PATH=..\\telegram-bot\\bot.js
# TELEGRAM_BOT_WORKDIR=..\\telegram-bot
# TELEGRAM_BOT_AUTOSTART=false
# TELEGRAM_ADMIN_BASE_URL=http://127.0.0.1:4791
# TELEGRAM_ADMIN_HOST=127.0.0.1
# TELEGRAM_ADMIN_PORT=4791
# MATRIX_BOT_ENTRY_PATH=..\\matrix-bot\\bot.js
# MATRIX_BOT_WORKDIR=..\\matrix-bot
# MATRIX_BOT_AUTOSTART=false
# WHATSAPP_BOT_ENTRY_PATH=..\\whatsapp-bot\\bot.js
# WHATSAPP_BOT_WORKDIR=..\\whatsapp-bot
# WHATSAPP_BOT_AUTOSTART=false
# WHATSAPP_ADMIN_BASE_URL=http://127.0.0.1:4793
# WHATSAPP_ADMIN_HOST=127.0.0.1
# WHATSAPP_ADMIN_PORT=4793

# Example: separate ComfyUI endpoints per studio.
# COMFYUI_MODEL_BASE_URL=http://192.168.1.70:8188
# COMFYUI_IMAGE_BASE_URL=http://192.168.1.71:8188
# COMFYUI_AUDIO_BASE_URL=http://192.168.1.72:8188
# COMFYUI_MUSIC_BASE_URL=http://192.168.1.73:8188
# COMFYUI_VIDEO_BASE_URL=http://192.168.1.74:8188
# COMFYUI_VIDEO_WORKFLOW_PATH=C:\\workflows\\video.json

# WhatsApp Cloud API credentials
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0

# Optional: prefill contacts shown in dashboard.
# JSON array or comma-separated numbers.
# WHATSAPP_CONTACTS=["+15551234567","+15559876543"]

# Admin API for dashboard/runtime integrations. Keep loopback locally; use a LAN bind
# plus MESSENGER_ADMIN_SHARED_SECRET when the dashboard is on another machine.
WHATSAPP_ADMIN_HOST=127.0.0.1
WHATSAPP_ADMIN_PORT=4793
MESSENGER_ADMIN_SHARED_SECRET=

# Matrix runtime config
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_ACCESS_TOKEN=
MATRIX_BOT_USER_ID=
# Persistent sync and E2EE state. Back this directory up and never share it.
MATRIX_STATE_DIRECTORY=
# Strongly recommended: comma-separated Matrix users and rooms permitted to run
# Chat/Image/3D workflows. With the default policy, empty lists lock workflows.
MATRIX_ALLOWED_USER_IDS=
MATRIX_ALLOWED_ROOM_IDS=
MATRIX_WORKFLOW_REQUIRE_ALLOWLIST=true

# Dashboard host when this bot runs on a different machine.
DASHBOARD_ACCESS_TOKEN=

# Admin API for dashboard/runtime integrations. Keep loopback locally; use a LAN bind
# plus MESSENGER_ADMIN_SHARED_SECRET when the dashboard is on another machine.
MATRIX_ADMIN_HOST=127.0.0.1
MATRIX_ADMIN_PORT=4792
MESSENGER_ADMIN_SHARED_SECRET=

# Shared dashboard API used by !chat command
DASHBOARD_BASE_URL=http://127.0.0.1:4782

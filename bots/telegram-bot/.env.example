# Telegram bot credentials
TELEGRAM_BOT_TOKEN=

# Dashboard host when Telegram runs on another machine.
DASHBOARD_BASE_URL=http://127.0.0.1:4782
DASHBOARD_ACCESS_TOKEN=

# Admin API used by the dashboard. Keep loopback locally; use a LAN bind and
# the shared secret when the dashboard is on another machine.
TELEGRAM_ADMIN_HOST=127.0.0.1
TELEGRAM_ADMIN_PORT=4791
MESSENGER_ADMIN_SHARED_SECRET=

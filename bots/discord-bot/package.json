{
  "name": "@urage/discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parallel Node.js + TypeScript rewrite target for DiscordBotURage",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "register": "tsx src/registerCommands.ts",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.1",
    "@urage/dashboard": "*",
    "@urage/server": "*",
    "@urage/shared": "*",
    "cheerio": "^1.2.0",
    "discord.js": "^14.25.1",
    "gif.js.optimized": "^1.0.1",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "sass": "^1.98.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
